# Copiar a .env.staging (no se versiona) para `npm run start:staging`.
# Valores del proyecto de STAGING (plataforma-db), nunca los de producción:
# Supabase → proyecto de staging → Connect / Project Settings → Data API.
SUPABASE_URL=https://<ref-de-staging>.supabase.co
# Clave publicable (sb_publishable_…): es pública, RLS protege los datos.
SUPABASE_ANON_KEY=<clave-publicable-de-staging>
